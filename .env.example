# Copy this file to ".env" and fill in your values.
# The .env file is private and is never committed to git.

# Password for the admin dashboard at /admin (required to use /admin)
ADMIN_TOKEN=change-me-to-a-long-secret

# Port the website runs on
PORT=3000

# Address to listen on. On a shared server use 127.0.0.1 (only nginx can reach it).
# Leave empty on your own computer.
HOST=

# Set to 1 when running behind nginx, so spam protection sees real visitor IPs
TRUST_PROXY=

# Shown on the website and in the PDF brochure when filled in
CONTACT_PHONE=
CONTACT_WHATSAPP=
CONTACT_EMAIL=

# Optional: send each new enquiry to Slack / Zapier / Make / n8n
ENQUIRY_WEBHOOK_URL=

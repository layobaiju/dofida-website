# Copy this file to ".env" and fill in your values.
# The .env file is private and is never committed to git.

# Password for the admin dashboard at /admin (required to use /admin)
ADMIN_TOKEN=change-me-to-a-long-secret

# Port the website runs on
PORT=3000

# Shown on the website and in the PDF brochure when filled in
CONTACT_PHONE=
CONTACT_WHATSAPP=
CONTACT_EMAIL=

# Optional: send each new enquiry to Slack / Zapier / Make / n8n
ENQUIRY_WEBHOOK_URL=
